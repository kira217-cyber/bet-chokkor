# সার্ভার
PORT=5000
NODE_ENV=development

# ডেটাবেস — আসল কানেকশন স্ট্রিং .env এ রাখুন, কখনো কমিট করবেন না
MONGO_URI=mongodb://<user>:<password>@<host>:27017/betchokkor?authSource=admin

# JWT — `openssl rand -hex 32` দিয়ে নিজের সিক্রেট বানিয়ে নিন
JWT_SECRET=<৬৪ অক্ষরের র‍্যান্ডম স্ট্রিং>
JWT_EXPIRE=7d

# CORS — কমা দিয়ে আলাদা করা অরিজিন। খালি রাখলে সব অরিজিন allowed
# (API টোকেন-ভিত্তিক, কুকি নয় — তাই CSRF ঝুঁকি নেই)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
